# Copy this file to .env.local (for `npm run dev`) and .env (for the seed
# script, which runs outside Next.js) and fill in your Supabase project's
# values — found in Project Settings → API in the Supabase dashboard.

# Safe to expose to the browser (used by lib/supabase/client.ts).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. NEVER expose this to the browser or commit it — it bypasses
# Row Level Security. Only used by scripts/seed.ts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
